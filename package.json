{
  "name": "micstudio",
  "version": "1.1.0",
  "private": true,
  "author": "MIC STUDIO",
  "description": "麦克风上位机（Electron + WebHID）Alpha 版界面",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:device": "node tools/vdevice/selftest.mjs",
    "test:coverage": "vitest run --coverage",
    "vdevice": "node tools/vdevice/run.mjs",
    "typecheck": "tsc --noEmit",
    "screenshot": "node scripts/screenshot.mjs",
    "dist:win": "electron-vite build && electron-builder --win portable",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "dist:installer": "electron-vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "1.6.1",
    "electron": "33.4.11",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.14.6",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "1.6.1"
  }
}
